# Heavy tier: Qwen2.5-14B Q4_K_M on the Metal GPU via llama.cpp.
# Loaded by scripts/llm_supervisor.sh; paths are relative to the repo root.
LLM_TIER=heavy
LLM_PORT=50051
LLM_HOST=[::]
LLM_ENGINE=llamacpp
LLM_MODEL_PATH=llm_service/models/Qwen2.5-14B-Instruct-Q4_K_M.gguf
LLM_CTX_SIZE=16384
LLM_MAX_TOKENS=2048
LLM_DEVICE=gpu
LLM_GPU_LAYERS=-1
# Flash attention is required for the quantized KV cache; q8_0 halves KV memory at 16K ctx.
LLM_FLASH_ATTN=1
LLM_KV_CACHE_TYPE=q8_0
# The 40-core GPU is under-filled at the 512 default during prompt processing.
LLM_N_BATCH=2048
LLM_N_UBATCH=512
LLM_MLOCK=1
