# Standard tier on MLX: mlx-community/Qwen2.5-3B-Instruct-4bit on the Metal GPU.
# Same port as standard.env, so run one or the other.
LLM_TIER=standard
LLM_PORT=50061
LLM_HOST=[::]
LLM_ENGINE=mlx
LLM_DEVICE=metal
LLM_MODEL_PATH=mlx-community/Qwen2.5-3B-Instruct-4bit
LLM_CTX_SIZE=8192
LLM_MAX_TOKENS=1024
# Weights live in the repo's .nosync cache (see docs/OPERATIONS.md); never hit the network at start.
HF_HUB_OFFLINE=1
