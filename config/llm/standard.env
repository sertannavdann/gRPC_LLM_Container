# Standard tier: Qwen2.5-3B Q5_K_M on the Metal GPU via llama.cpp.
LLM_TIER=standard
LLM_PORT=50061
LLM_HOST=[::]
LLM_ENGINE=llamacpp
LLM_MODEL_PATH=llm_service/models/qwen2.5-3b-instruct-q5_k_m.gguf
LLM_CTX_SIZE=8192
LLM_MAX_TOKENS=1024
LLM_DEVICE=gpu
LLM_GPU_LAYERS=-1
LLM_FLASH_ATTN=1
LLM_KV_CACHE_TYPE=f16
LLM_MLOCK=1
